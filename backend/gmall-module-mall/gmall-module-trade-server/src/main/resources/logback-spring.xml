<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <!--包含Spring boot对logback日志的默认配置-->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <!--    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}}/spring.log}"/>-->
    <!--定义日志文件的存储地址,使用绝对路径-->

    <!-- 日志文件存储路径 -->
    <springProperty scope="context" name="log.path" source="log.path"  defaultValue="./logs/trade-server"/>
    <springProperty scope="context" name="application.name" source="spring.application.name"  defaultValue="trade-server"/>
    <springProperty scope="context" name="HOSTNAME" source="HOSTNAME" defaultValue="localhost"/>

    <!-- Loki 推送地址，可用 gmall.logging.loki.url 覆盖 -->
    <springProperty scope="context" name="lokiUrl" source="gmall.logging.loki.url" defaultValue="http://127.0.0.1:31920/loki/api/v1/push"/>
    <!-- Loki 推送开关：LOKI=真实推送，LOKI_NOP=丢弃不推送（Loki 不可用时避免中断启动） -->
    <springProperty scope="context" name="lokiAppender" source="gmall.logging.loki.appender" defaultValue="LOKI_NOP"/>
    <springProfile name="!local">
        <!-- 非 local 环境默认推送 -->
        <springProperty scope="context" name="lokiAppender" source="gmall.logging.loki.appender" defaultValue="LOKI"/>
    </springProfile>


    <!-- 日志输出格式 -->
    <!-- 彩色日志 -->
    <!-- 彩色日志依赖的渲染类 - 使用新的class属性替代converterClass -->
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 控制台日志格式（使用Spring Boot默认格式） -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- 文件日志格式 -->
    <property name="FILE_LOG_PATTERN"
              value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- 错误日志专用格式 -->
    <property name="ERROR_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level ${PID:- } --- [%t] %-40.40logger{39} : %msg%n%wEx"/>

    <!-- Console 输出设置 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- 空实现，用于关闭 Loki 推送时占位 -->
    <appender name="LOKI_NOP" class="ch.qos.logback.core.helpers.NOPAppender"/>

    <!-- Loki 输出器。注意 loki4j 版本为 1.6.0：
         类名为 Loki4jAppender（老版本是 LokiAppender）、
         batch 参数为 appender 顶层平铺属性（不再是嵌套的 &lt;batch&gt;）、
         认证节点为 &lt;auth&gt;（老版本是 &lt;basicAuth&gt;）、sortByTime 已移除 -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <auth>
                <username>admin</username>
                <password>admin</password>
            </auth>
        </http>
        <batchMaxItems>1000</batchMaxItems>
        <batchMaxBytes>4194304</batchMaxBytes>
        <batchTimeoutMs>5000</batchTimeoutMs>
        <format>
            <label>
                <!-- 低基数标签，千万别把 traceId/userId 放进 label -->
                <pattern>application=${application.name},hostname=${HOSTNAME},level=%level</pattern>
                <readMarkers>true</readMarkers>
            </label>
            <message>
                <!-- 结构化 JSON 正文 -->
                <pattern>
                    {"timestamp": "%d{yyyy-MM-dd HH:mm:ss.SSS}", "level": "%level", "logger": "%logger{36}.%method", "method":"%M", "line":"%line", "thread": "%thread", "message": "%msg%n"}
                </pattern>
            </message>
        </format>
    </appender>

    <!-- INFO级别日志文件输出（按天滚动） -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/trade_info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/trade.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 最大保留天数 -->
            <maxHistory>7</maxHistory>
            <!-- 单个文件最大大小 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 只记录INFO及以上级别的日志 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- ERROR级别日志文件输出（按天滚动） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/trade_error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- 错误日志保留更长时间 -->
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${ERROR_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 只记录ERROR级别日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- DEBUG级别日志文件输出 -->
    <appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/trade_debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/debug.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>3</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
            <!-- Spring Boot默认情况下，日志文件10M时，会切分日志文件,这样设置日志文件会在100M时切分日志 -->
            <!-- <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                 <maxFileSize>10MB</maxFileSize>
             </timeBasedFileNamingAndTriggeringPolicy>-->
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <!-- 异步输出（性能优化） -->
    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志，队列满时丢弃TRACE、DEBUG、INFO级别日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 队列深度，默认256 -->
        <queueSize>512</queueSize>
        <!-- 是否包含调用者信息，会影响性能 -->
        <includeCallerData>false</includeCallerData>
        <!-- 关联的appender -->
        <appender-ref ref="FILE_INFO"/>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>256</queueSize>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE_ERROR"/>
    </appender>

    <appender name="ASYNC_DEBUG" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE_DEBUG"/>
    </appender>

    <!-- 日志级别配置 -->

    <!-- 系统模块日志级别控制 -->
    <logger name="com.zp" level="INFO"/>

    <!-- Spring日志级别控制，减少框架日志输出 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- SQL日志输出配置 -->
    <logger name="org.apache.ibatis" level="DEBUG"/>
    <logger name="java.sql" level="DEBUG"/>
    <logger name="java.sql.Connection" level="DEBUG"/>
    <logger name="java.sql.Statement" level="DEBUG"/>
    <logger name="java.sql.PreparedStatement" level="DEBUG"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- MyBatis缓存日志配置 -->
    <logger name="org.apache.ibatis.cache.decorators.LoggingCache" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_DEBUG"/>
    </logger>

    <!-- 第三方库日志控制 -->
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="com.rabbitmq" level="WARN"/>
    <logger name="com.netflix" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <!-- 根日志配置 -->
    <root level="INFO">
        <!-- 控制台输出 -->
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="${lokiAppender}"/>
        <!-- 异步文件输出 -->
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </root>

    <!-- 环境相关配置 -->
    <springProfile name="dev,test,local">
        <!-- 开发测试环境：输出更多日志到控制台。
             additivity="false" 时日志不走 root，需自己挂 Loki -->
        <logger name="com.zp" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_DEBUG"/>
            <appender-ref ref="${lokiAppender}"/>
        </logger>
    </springProfile>

    <springProfile name="prod">
        <!-- 生产环境：减少控制台输出，只输出到文件 -->
        <root level="INFO">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
        <logger name="com.zp" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_INFO"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </logger>
    </springProfile>

</configuration>